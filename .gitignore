# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local config & secrets
.env
.env.local
backend/app/config/settings.yaml
backend/app/config/settings.*.yaml
!backend/app/config/settings.example.yaml

# Runtime data (project files persist on disk but should not be in git)
data/projects/*/
!data/projects/.gitkeep

# Logs
*.log
logs/

# Refer (read-only reference from PPT project — proprietary, must NOT be published)
refer/

# M22 a11y check transient report (regenerated per run)
scripts/m22_a11y_report.md

# Reports / exports
data/projects/*/exports/

# V2-F M15 — demo signing keys + persisted signatures; never publish
data/projects/*/keys/
data/projects/*/signatures/
data/users.json

# M21 (v2.3) — multi-tenant runtime artefacts (per-installation)
data/tenants.json
data/tenants/
data/auth/
data.pre-tenant.bak/
data/projects.json

# V3-A M17 — generated SDKs (regenerate from live openapi.json)
sdk/ts/
sdk/py/

# V3-A M17 — pytest-cov artifact
backend/.coverage
backend/htmlcov/
backend/coverage.xml

# M19 — project backup zips (transient downloads)
data/backups/

# M20 — generated sample-project parquet (regenerable via
#       `python scripts/generate_sample_data.py`)
data/sample_projects/
