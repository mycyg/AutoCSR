# Copy to .env (gitignored) and fill in real values.
#
# Loaded by docker compose (top-level) and via the FastAPI config layer at
# startup. Local non-Docker dev can still rely on backend/app/config/settings.yaml;
# env values override that file.

# ---- LLM credentials (required for non-mock writer/editor runs) -----------
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- Auth ---------------------------------------------------------------
# Set a long random value in production. Compose also disables dev-mode
# header fallback by default unless you explicitly set true here.
AUTOCSR_JWT_SECRET=
AUTOCSR_AUTH_DEV_MODE=false

# Optional vision LLM split (falls back to primary LLM if unset).
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=

# Optional embedding model (corpus second-tier recall; falls back to grep).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ---- Queue backend (M19) -------------------------------------------------
# inmemory  → single-process, no Redis required (fine for dev / e2e)
# arq       → real persistent queue; needs the redis service from compose
AUTOCSR_QUEUE_BACKEND=arq
AUTOCSR_REDIS_URL=redis://redis:6379/0

# ---- Mock toggles (CI / e2e) ---------------------------------------------
# Set =1 to skip real LLM round-trips in tests / CI.
CSR_WRITER_MOCK=
CSR_EDITOR_MOCK=

# ---- Debug ---------------------------------------------------------------
CSR_TIMING=1            # 1 = stderr [TIMING][...] lines
CSR_DATA_REDACT=strict  # strict / mild / off — sample redaction sent to LLM
