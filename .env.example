# LLM 接口（优先级：环境变量 > settings.yaml）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：视觉模型分离（看不到图就 fallback 到主模型）
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=

# 可选：Embedding（用于 corpus 二层召回，没有时退化为纯 grep）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 调试开关
CSR_TIMING=1            # 1 = stderr 输出 [TIMING][...] 行
CSR_DATA_REDACT=strict  # strict / mild / off ；控制送 LLM 的样例脱敏强度
